FROM python:3.9-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Preserve exact local directory structure inside the container
COPY backend/ ./backend/
COPY frontend/ ./frontend/

EXPOSE 5000

# Change working directory to backend so relative paths work exactly like locally
WORKDIR /app/backend

# Run the application
CMD ["python", "app.py"]